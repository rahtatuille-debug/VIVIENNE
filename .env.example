# Copy to .env (cp .env.example .env) and fill in. Never commit .env.
# Free key, no card: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here
# Models to try in order, separated by commas. If one is busy, out of quota or
# retired, Vivienne moves to the next. Names come from AI Studio.
VIVIENNE_MODEL=gemini-3.5-flash,gemini-3.6-flash,gemini-3.8-flash,gemini-3.5-flash-lite
